// Input parameters
params.type="simplex_assembly"   // change to "duplex_assembly" or "amplicon" to test the other workflows

params.reads="/cluster/shared/vetinst/datasets/testdata/pod5_test_files/pod5"
params.samplesheet.location="/cluster/shared/vetinst/datasets/testdata/pod5_test_files/sample_sheet.csv"

//////////////////////////
// settings for DORADO
//////////////////////////
params.flowcell="FLO-MIN114"
params.dorado.barcode="SQK-RBK114-24"
params.dorado.moddir="/cluster/projects/nn9305k/src/miniconda/envs/dorado_gpu_2.1.0/models"
params.dorado.model="dna_r10.4.1_e8.2_400bps_sup@v5.2.0"

/////////////////////////////////////
// setttings for NanoFilt filtering
/////////////////////////////////////
params.quality="9"
params.minlength="300"
params.maxlength="2147483647"

/////////////////////////////////////
// setttings for EMU classification
/////////////////////////////////////
params.emu.db="/cluster/shared/vetinst/emu_dbs/emu_db"